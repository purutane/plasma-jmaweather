<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="locationMode" type="Enum">
            <label>地域の決め方</label>
            <choices>
                <choice name="Auto"/>
                <choice name="Manual"/>
            </choices>
            <default>0</default>
        </entry>
        <entry name="detectedOfficeCode" type="String">
            <label>自動判定した府県予報区コード（判定前は空）</label>
            <default></default>
        </entry>
        <entry name="detectedAreaCode" type="String">
            <label>自動判定した一次細分区域コード（判定前は空）</label>
            <default></default>
        </entry>
        <entry name="detectedAt" type="String">
            <label>最後に自動判定した時刻（ISO 8601）</label>
            <default></default>
        </entry>
        <entry name="locationMigrated" type="Bool">
            <label>1.0 から持ち越した地域指定を手動へ寄せ終えたか（UI には出さない）</label>
            <default>false</default>
        </entry>
        <entry name="carriedMinStation" type="String">
            <label>控えてある最低気温の観測所コード（UI には出さない）</label>
            <default></default>
        </entry>
        <entry name="carriedMins" type="String">
            <label>控えてある最低気温「日付=℃」を ; でつないだもの（UI には出さない）</label>
            <default></default>
        </entry>
        <entry name="officeCode" type="String">
            <label>府県予報区コード</label>
            <default>130000</default>
        </entry>
        <entry name="areaCode" type="String">
            <label>一次細分区域コード</label>
            <default>130010</default>
        </entry>
        <entry name="areaName" type="String">
            <label>表示用の地域名（コードから組み立てられない場合の控え）</label>
            <default>東京都 - 東京地方</default>
        </entry>
        <entry name="updateInterval" type="Int">
            <label>更新間隔（分）</label>
            <default>30</default>
        </entry>
        <entry name="panelContent" type="Enum">
            <label>パネルに出す内容</label>
            <choices>
                <choice name="IconOnly"/>
                <choice name="Temperature"/>
                <choice name="Precipitation"/>
                <choice name="TemperatureAndPrecipitation"/>
            </choices>
            <default>1</default>
        </entry>
        <entry name="showAreaNameInPanel" type="Bool">
            <label>パネルに地域名も出す</label>
            <default>false</default>
        </entry>
        <entry name="showWarnings" type="Bool">
            <label>警報・注意報を表示する</label>
            <default>true</default>
        </entry>
    </group>
</kcfg>
